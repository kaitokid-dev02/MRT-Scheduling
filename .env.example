# Copy to .env (never commit .env). Loaded automatically by run.py / `flask`.
APP_ENV=development            # development | testing | production
SECRET_KEY=change-me           # REQUIRED in production: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password        # dev only. In production set ADMIN_PASSWORD_HASH instead:
# python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
# ADMIN_PASSWORD_HASH=
APP_TIMEZONE=Asia/Manila
FLAT_FARE=55
# DATABASE_PATH=mrt.db         # relative paths live under instance/
